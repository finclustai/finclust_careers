# ── Supabase project ─────────────────────────────────────────────────────────
# ref: your Supabase project ref
SUPABASE_URL="https://<project-ref>.supabase.co"

# TODO(you): Settings → API Keys → "secret" key (starts sb_secret_).
# API ONLY. Never prefix NEXT_PUBLIC_, never import from apps/web.
SUPABASE_SECRET_KEY=""

SUPABASE_RESUME_BUCKET="resumes"

# ── Database ─────────────────────────────────────────────────────────────────
# Password is percent-encoded: @ must be %40 or the URL parses wrong.
# TODO(you): replace REGION with the one shown in the dashboard string,
# e.g. ap-south-1. Copy the host verbatim — the prefix is aws-0 or aws-1.
#
# Supavisor transaction pooler, port 6543. connection_limit=1 (ADR-0004).
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&connect_timeout=10&pool_timeout=20"
# Session pooler, port 5432. Migrations only.
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# TODO(you): openssl rand -base64 32
JWT_SECRET=""
SESSION_TTL_HOURS="12"

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL="/api"

# NOTE: NEXT_PUBLIC_SUPABASE_URL and the publishable key were removed on purpose.
# The browser never talks to Supabase directly — it PUTs to a signed URL our API
# mints, using plain fetch (ADR-0003). That keeps the Supabase SDK out of the
# bundle and means no Supabase key of any kind ships to the client.
